# ============================================================
# 环境变量模板（可安全提交到版本库，请勿写入真实密码）
#
# 使用方式：复制本文件为 .env.local，再填入真实值
#   cp .env.example .env.local
#
# 本项目仅需 1 个环境变量；数据库访问全部在后端通过 pg 连接池完成，
# 前端不持有任何凭证，因此无需 SUPABASE_KEY / anon key / service_role key。
# ============================================================

# Supabase Postgres 连接串
#
# 获取方式：Supabase 项目页 -> 顶部 "Connect" -> 选择 "Session pooler" -> 复制 URI
#
# 格式说明：
#   直连（本机 IPv6 可达，适合本地开发）：
#     postgresql://postgres:<数据库密码>@db.<project-ref>.supabase.co:5432/postgres
#   Session Pooler（适合 Vercel / Netlify 等纯 IPv4 环境）：
#     postgresql://postgres.<project-ref>:<数据库密码>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# 数据库密码位置：Supabase -> Project Settings -> Database -> Database password
# 若已遗忘，可在该页面点 "Reset database password" 重置。
SUPABASE_POSTGRES_SESSION_POOL_URL="postgresql://postgres:<your-database-password>@db.<project-ref>.supabase.co:5432/postgres"
